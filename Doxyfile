# Doxygen configuration for name-card. Run from the project root:
#   doxygen Doxyfile
# Output goes to docs/doxygen/ (ignored by git).
PROJECT_NAME           = "name-card"
PROJECT_BRIEF          = "Personal name card website served with Flask"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.py *.md
EXTRACT_ALL            = YES
OPTIMIZE_OUTPUT_JAVA   = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
